{
  "schemaVersion": 1,
  "sourceCommit": "caeb9d4b18b3786a0e753e29a12c5733857664ed",
  "identities": {
    "userApiKey": "ari_ key created by a signed-in user",
    "botToken": "ari_ token scoped to one agent",
    "oauthUser": "user-authorized OAuth access token",
    "local": "does not call an authenticated API"
  },
  "rules": [
    {
      "commands": ["auth login", "auth logout", "auth set-token", "config", "completion", "setup-openclaw", "space init", "space build"],
      "identities": ["local"]
    },
    {
      "commands": ["economy", "chat", "user"],
      "identities": ["oauthUser"],
      "note": "The server enforces economy or agents OAuth scopes. The CLI never retries with another identity."
    },
    {
      "commands": ["space storage"],
      "identities": ["oauthUser"],
      "note": "Space storage is a runtime API and requires a Space-bound OAuth access token."
    },
    {
      "commands": ["delivery", "action agent-manifest", "action pending"],
      "identities": ["botToken"],
      "note": "Visibility is restricted by the caller agent on the server."
    },
    {
      "commands": ["calendar", "doc", "form", "mindmap", "slide", "workbook", "image", "external-image"],
      "identities": ["userApiKey", "oauthUser"]
    },
    {
      "commands": ["auth whoami", "message", "file", "note", "notebook", "memory", "kanban", "conversation", "skill", "skill-package", "search", "resolve", "memo", "agent", "profile", "sticker", "theme", "community", "space", "stats", "list", "app", "action", "workflow", "cron", "trigger", "webhook", "autopilot"],
      "identities": ["userApiKey", "botToken"],
      "note": "Specific route scopes and ownership are still enforced by the server."
    },
    {
      "commands": ["auto-send", "expert"],
      "identities": ["local"],
      "note": "Unsupported compatibility commands fail before making a request."
    },
    {
      "commands": ["painter"],
      "identities": ["userApiKey", "botToken"],
      "note": "Legacy-only API surface; there is no equivalent current /api/v1 route."
    }
  ]
}
