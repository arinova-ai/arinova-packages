{
  "name": "@arinova-ai/agent-sdk",
  "version": "0.2.0",
  "description": "SDK for connecting AI agents to Arinova Chat",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "arinova",
    "agent",
    "sdk",
    "websocket",
    "streaming",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arinova-ai/arinova-packages.git",
    "directory": "packages/agent-sdk"
  },
  "homepage": "https://github.com/arinova-ai/arinova-packages/tree/main/packages/agent-sdk",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
