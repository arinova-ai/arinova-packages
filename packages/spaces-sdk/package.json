{
  "name": "@arinova-ai/spaces-sdk",
  "version": "0.4.0",
  "description": "Arinova Spaces SDK — OAuth PKCE, managed commerce/storage, and agent chat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arinova-ai/arinova-packages.git",
    "directory": "packages/spaces-sdk"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run && pnpm build && tsc -p test-dts/tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
