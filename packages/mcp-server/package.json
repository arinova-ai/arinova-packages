{
  "name": "@arinova-ai/mcp-server",
  "version": "0.1.0",
  "description": "MCP server bridge for Arinova platform actions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "arinova-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./dist/cli.js": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "arinova",
    "mcp",
    "model-context-protocol",
    "agent",
    "tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
