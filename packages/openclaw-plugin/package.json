{
  "name": "@arinova-ai/openclaw-arinova-ai",
  "version": "0.0.74",
  "description": "OpenClaw plugin for Arinova Chat — channel (A2A streaming) + Virtual Office (agent status tracking via SSE)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arinova-ai/arinova-packages.git",
    "directory": "packages/openclaw-plugin"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:integration": "RUN_OPENCLAW_INTEGRATION=1 vitest run --config vitest.integration.config.ts",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "openclaw-arinova-ai",
      "label": "Arinova Chat",
      "selectionLabel": "Arinova Chat (A2A streaming)",
      "docsPath": "/channels/openclaw-arinova-ai",
      "docsLabel": "openclaw-arinova-ai",
      "blurb": "Human-to-AI messaging via Arinova Chat with native streaming.",
      "aliases": [
        "arinova"
      ],
      "order": 70,
      "quickstartAllowFrom": true
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026"
  },
  "dependencies": {
    "@arinova-ai/agent-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "openclaw": "2026.7.2-beta.5",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
